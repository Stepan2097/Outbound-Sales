PORT=3000
NODE_ENV=production

OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_WRITING_MODEL=anthropic/claude-sonnet-5

APIFY_API_TOKEN=
APIFY_LEAD_DATABASE_ACTOR_ID=kVYdvNOefemtiDXO5
APIFY_MAX_CHARGE_USD=0.05
APIFY_COMPANY_PEOPLE_ACTOR_ID=harvestapi/linkedin-company-employees
APIFY_SECONDARY_COMPANY_PEOPLE_ACTOR_ID=scraper-engine/linkedin-company-employees-scraper
APIFY_CONTACT_FINDER_ACTOR_ID=inexhaustible_glass/linkedin-email-finder
APIFY_PERSON_ENRICHMENT_ACTOR_ID=enrich-crm/enrich-crm-enrich-contact
APIFY_CONTACT_MAX_CHARGE_USD=0.20
APIFY_MAX_ACTORS_PER_LEAD=3
APIFY_ENRICHMENT_CACHE_DAYS=30

# Optional legacy provider. The default contact path is the cost-capped Apify waterfall above.
FULLENRICH_API_KEY=
FULLENRICH_API_BASE_URL=https://app.fullenrich.com/api/v2
FULLENRICH_WEBHOOK_BASE_URL=https://outbound-sales.example.com
FULLENRICH_WEBHOOK_SECRET=
FULLENRICH_INCLUDE_WORK_EMAIL=true
FULLENRICH_INCLUDE_PERSONAL_EMAIL=false
FULLENRICH_INCLUDE_PHONE=true
FULLENRICH_TIMEOUT_SECONDS=105

# Call-transcript webhook (POST /api/webhooks/call-transcript, header X-Webhook-Token).
# The app has no screen for it: a token set through the API lives only in
# memory, so every deploy closes the webhook until it is sent again; set it here
# and it survives restarts.
# Optional: with it unset nothing changes.
TRANSCRIPT_WEBHOOK_TOKEN=
TRANSCRIPT_PROVIDER=

MCP_PORTAL_BASE_URL=
MCP_RESOURCE_NAMESPACE=
MCP_API_TOKEN=

CRM_NAME=Custom CRM
CRM_API_BASE_URL=
CRM_API_TOKEN=
CRM_LEAD_ENDPOINT=
CRM_ACTIVITY_ENDPOINT=
CRM_SYNC_DIRECTION=push_and_pull

# Advantage CRM read/write bridge.
SUPABASE_URL=
SUPABASE_API_KEY=

# Optional direct CRM database health check.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=

# Product knowledge and document memory. Keep separate from the CRM database.
KNOWLEDGE_SUPABASE_URL=
KNOWLEDGE_SUPABASE_API_KEY=
KNOWLEDGE_POSTGRES_HOST=
KNOWLEDGE_POSTGRES_PORT=5432
KNOWLEDGE_POSTGRES_DATABASE=postgres
KNOWLEDGE_POSTGRES_USER=
KNOWLEDGE_POSTGRES_PASSWORD=

# ── LinkedIn warm-up ────────────────────────────────────────────────────────
# The Supabase that Anty syncs into. It holds both the browser profiles and the
# warm-up's own wl_* tables, which is why an account and the browser it runs in
# stay one object. Service role: those tables are closed by RLS and reached only
# through this app, which checks who is asking first.
ANTY_SUPABASE_URL=
ANTY_SERVICE_ROLE_KEY=

# Which Anty team's profiles this workspace warms. Empty means every team.
ANTY_TEAM_ID=

# Any passphrase. Without it the warm-up refuses to store account and proxy
# passwords rather than keeping them in the clear. It must survive a restart,
# so unlike the workspace vault it cannot be a per-boot random key.
LINKEDIN_SECRET_KEY=

# The lead queue the warm-up sends connection requests to. The URL and key
# default to SUPABASE_URL / SUPABASE_API_KEY above, which is the same project;
# set these only to point the warm-up at a different CRM.
WARMUP_CRM_SUPABASE_URL=
WARMUP_CRM_SERVICE_ROLE_KEY=

# Which folder and whose contacts the warm-up opens on. Only the starting
# values: targeting is chosen in the app and saved with the workspace, and
# leaving both empty simply means nothing is picked yet.
WARMUP_CRM_LEADS_FOLDER_ID=
WARMUP_CRM_LEADS_OWNER_ID=

# Everybody who writes to a warm-up account and is in nobody's CRM is added to it,
# in a folder of its own (made on first use). The owner above, when set, becomes
# their owner. INBOX_ADOPT_CONTACTS=0 turns this off.
INBOX_ADOPT_CONTACTS=1
INBOX_CONTACTS_FOLDER=Вхідні розмови LinkedIn

# Replies written on the Inbox screen are sent by the account itself, in its next
# session. This is the most one account is asked to send in a day, those already
# sent and those waiting together (1–50).
INBOX_REPLIES_PER_DAY=10

# The shared secret the LinkedIn agent signs in with. It runs on somebody's Mac
# beside Anty, has no workspace session and cannot get one, so it sends this as
# an X-Agent-Token header on /api/warmup/agent and /api/warmup/agent/*.
#
# Empty means those routes are CLOSED, not open — an agent route that opened
# because a deployment forgot a variable would be a service-role key on the
# public internet. Nothing else under /api/warmup accepts it: a token that can
# post a message must not be able to read the workspace.
WARMUP_AGENT_TOKEN=

# Local Mac agent (install its dependency with npm ci --prefix agent).
WARMUP_PORTAL=http://127.0.0.1:4173
# Optional paths; defaults are Chrome.app and the user's Anty data directory.
WARMUP_CHROME_PATH=
WARMUP_ANTY_DIR=

# Cold email (ESP). Secrets live here — in the deployment's environment — and
# nowhere else: not in the code, the workspace state, the journal or a task.
# The service account key for Google Workspace is ESP 1's (see ESP_GMAIL_SETUP.md).
# Spamhaus answers DBL lookups only through a DQS key; without it the blocklist
# check says «не перевірено», never «чисто».
SPAMHAUS_DQS_KEY=
# The ESP journal (append-only). Defaults to esp-journal.jsonl beside STATE_FILE_PATH.
ESP_JOURNAL_PATH=
